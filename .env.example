# ==============================================================================
# WATERMARK REMOVER CONFIGURATION (.env.example)
# ==============================================================================

# --- Frontend Deployment (Vercel) ---
# Set VITE_API_URL in your Vercel Project Settings -> Environment Variables
# Example: https://watermark-remover-backend.onrender.com
VITE_API_URL=http://localhost:8000

# --- Backend Deployment (Render) ---
# Render automatically injects PORT. Configure others in Render Dashboard -> Environment Variables.
PORT=8000
APP_ENV=development
MAX_UPLOAD_SIZE_MB=50
MAX_PAGES=100
MAX_PROCESSING_TIME=300
UPLOAD_DIR=./uploads
RESULT_DIR=./results
FILE_RETENTION_MINUTES=30

# CORS Allowed Origins: Single URL or comma-separated URLs
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=https://your-frontend.vercel.app
